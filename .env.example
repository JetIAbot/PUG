# PUG - Plantilla de configuración local
# Copiar como .env y ajustar valores
# NUNCA hacer commit de credenciales reales

# Entorno
APP_ENV=development
DEBUG=True
DEMO_MODE=True

# Almacenamiento local o ruta UNC SMB (ejemplo: \\10.0.0.7\.private)
DATOS_PATH=datos
# Metadatos de la cola web; nunca contiene contraseñas
JOB_STORE_PATH=datos/.pug_jobs.json
# Tiempo mínimo entre actualizaciones de una matrícula (segundos)
REFRESH_COOLDOWN_SECONDS=900
# Número máximo de extracciones Selenium simultáneas
EXTRACTION_WORKERS=2
# Capacidad de espera de la cola, sin contar los trabajos en ejecución
MAX_PENDING_JOBS=20
# Tiempo máximo por extracción (segundos)
EXTRACTION_TIMEOUT_SECONDS=300

# Portal universitario
PORTAL_URL=https://segreteria.unigre.it
BROWSER=edge
HEADLESS_MODE=True

# Logging
LOG_LEVEL=INFO
AUTO_CLEANUP=True
LOG_MAX_DAYS=7

# Seguridad
MASK_CREDENTIALS=True
LOG_SENSITIVE_DATA=False
